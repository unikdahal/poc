<ivysettings>
  <settings defaultResolver="public-maven" />
  <resolvers>
    <chain name="public-maven" returnFirst="true">
      <ibiblio name="central" m2compatible="true" root="https://repo.maven.apache.org/maven2/" />
      <ibiblio name="central-mirror" m2compatible="true" root="https://maven-central.storage-download.googleapis.com/maven2/" />
      <ibiblio name="central-repo1" m2compatible="true" root="https://repo1.maven.org/maven2/" />
    </chain>
  </resolvers>
</ivysettings>
